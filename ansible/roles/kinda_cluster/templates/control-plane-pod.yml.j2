apiVersion: v1
kind: Pod
metadata:
  name: kinda-control-plane
  namespace: {{ kinda_namespace }}
  labels:
    app.kubernetes.io/name: kinda-control-plane
    app.kubernetes.io/part-of: kinda
    kinda.local/role: control-plane
spec:
  hostname: kinda-control-plane
  nodeName: {{ kinda_outer_control_plane_node }}
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
    - key: node-role.kubernetes.io/master
      operator: Exists
      effect: NoSchedule
  restartPolicy: Always
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchLabels:
                app.kubernetes.io/part-of: kinda
            topologyKey: kubernetes.io/hostname
  containers:
    - name: node
      image: {{ kinda_node_image }}
      imagePullPolicy: IfNotPresent
      env:
        - name: KINDA_NODE_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
      securityContext:
        privileged: true
      resources:
        requests:
          cpu: {{ kinda_control_plane_cpu_request }}
          memory: {{ kinda_control_plane_memory_request }}
      volumeMounts:
        - name: bootstrap
          mountPath: /etc/kinda/bootstrap
          readOnly: true
        - name: cgroup
          mountPath: /sys/fs/cgroup
        - name: lib-modules
          mountPath: /lib/modules
          readOnly: true
        - name: var-lib-containerd
          mountPath: /var/lib/containerd
        - name: var-lib-kubelet
          mountPath: /var/lib/kubelet
        - name: run
          mountPath: /run
        - name: tmp
          mountPath: /tmp
  volumes:
    - name: bootstrap
      configMap:
        name: {{ kinda_bootstrap_configmap_name }}
        defaultMode: 0755
    - name: cgroup
      hostPath:
        path: /sys/fs/cgroup
    - name: lib-modules
      hostPath:
        path: /lib/modules
    - name: var-lib-containerd
      emptyDir: {}
    - name: var-lib-kubelet
      emptyDir: {}
    - name: run
      emptyDir: {}
    - name: tmp
      emptyDir: {}
